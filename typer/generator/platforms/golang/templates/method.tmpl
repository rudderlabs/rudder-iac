{{ comment .Doc }}
func (r *RudderTyperAnalytics) {{ .Name }}(identity Identity{{ range .Params }}, {{ . }}{{ end }}, opts ...Option) error {
{{- with .Payload }}
{{- if .Variant }}
	if isNil({{ $.Param }}) {
		return {{ $.OnNil }}
	}
{{- end }}
{{- if $.Pointer }}
	var {{ $.Var }} analytics.{{ .Payload }}
	if {{ $.Param }} != nil {
		var err error
		if {{ $.Var }}, err = {{ $.Param }}.To{{ .Payload }}(); err != nil {
			return err
		}
	}
{{- else }}
	{{ $.Var }}, err := {{ if .MapAlias }}snapshot({{ $.Param }}){{ else }}{{ $.Param }}.To{{ .Payload }}(){{ end }}
	if err != nil {
		return err
	}
{{- end }}
	return {{ $.Send }}
{{- else }}
	return {{ .OnNil }}
{{- end }}
}

// rudderTyperContext returns the metadata sent as context.ruddertyper. It
// builds a new map on every call because Config.Callback receives the
// message and could otherwise modify a shared one.
func rudderTyperContext() map[string]any {
	return map[string]any{
		"platform": "go",
		"rudderCLIVersion": {{ quote .RudderCLIVersion }},
		"trackingPlanId": {{ quote .PlanID }},
		"trackingPlanVersion": {{ .PlanVersion }},
	}
}
{{ runtime }}
{{- if or .Helpers.page .Helpers.screen }}

// categoryMode says how a page or screen rule treats properties.category.
type categoryMode int

const (
	categoryDeclared categoryMode = iota // the schema declares category
	categoryOpen                         // undeclared, but the schema accepts extra keys
	categoryClosed                       // undeclared, and the schema accepts no extra keys
)

// withCategory applies WithCategory. props is always a private copy, so it
// can be modified in place.
func (o callOptions) withCategory(props analytics.Properties, mode categoryMode) (analytics.Properties, error) {
	if o.category == nil {
		return props, nil
	}
	category := *o.category
	if existing, ok := props["category"]; ok {
		if existing == category {
			return props, nil
		}
		return nil, fmt.Errorf("%w: WithCategory(%q) differs from properties.category %v", ErrCategoryConflict, category, existing)
	}
	if mode != categoryOpen {
		return nil, fmt.Errorf("%w: WithCategory(%q) on a payload that does not accept an undeclared category", ErrCategoryConflict, category)
	}
	if props == nil {
		props = analytics.Properties{}
	}
	props["category"] = category
	return props, nil
}
{{- end }}
{{- if .UsesWithAdditional }}

// withAdditional starts an object from the keys of extra that the tracking
// plan does not declare. Declared keys always come from the typed fields.
func withAdditional(extra map[string]any, declared ...string) map[string]any {
	m := make(map[string]any, len(extra)+len(declared))
	for k, v := range extra {
		if !slices.Contains(declared, k) {
			m[k] = v
		}
	}
	return m
}
{{- end }}
{{- if .UsesRequired }}

// required returns v, or a value whose serialization fails when v is nil, so
// a required variant left unset is reported instead of being sent as null.
func required(v any, key string) any {
	if isNil(v) {
		return missingValue(key)
	}
	return v
}

type missingValue string

func (k missingValue) wireValue() (any, error) {
	return nil, fmt.Errorf("%w: required property %q is not set", ErrInvalidValue, string(k))
}

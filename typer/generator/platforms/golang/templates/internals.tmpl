func (r *RudderTyperAnalytics) track(identity Identity, event string, properties analytics.Properties, opts []Option) error {
	o, err := applyOptions(opts)
	if err != nil {
		return err
	}
	return r.client.Enqueue(analytics.Track{
		UserId:            identity.UserID,
		AnonymousId:       identity.AnonymousID,
		Event:             event,
		Properties:        properties,
		Context:           o.analyticsContext(nil),
		Integrations:      o.integrations,
		OriginalTimestamp: o.timestamp,
		MessageId:         o.messageID,
	})
}

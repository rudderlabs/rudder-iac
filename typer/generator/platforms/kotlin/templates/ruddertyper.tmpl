private fun JsonElement.toTransportValue(): Any? = when (this) {
    is JsonNull -> null
    is JsonObject -> toTransportMap()
    is JsonArray -> map { it.toTransportValue() }
    is JsonPrimitive -> if (isString) content else booleanOrNull ?: longOrNull ?: doubleOrNull ?: content
}

private fun JsonObject.toTransportMap(): Map<String, Any?> = mapValues { it.value.toTransportValue() }

/**
 * Sends the events built by [RudderTyper] through a RudderStack SDK.
 *
 * Implement it once per platform on top of that platform's SDK, for example the Kotlin SDK on
 * Android and the Swift SDK on iOS. Values are plain Kotlin types (String, Boolean, Long, Double,
 * Map, List, null) so that the interface also bridges to Swift.
 *
 * [context] holds the ruddertyper context and any custom context. Attach it to the event as custom
 * context, which both the Kotlin and the Swift SDK accept in the options of an event call.
 */
interface RudderTyperTransport {
    fun track(name: String, properties: Map<String, Any?> = emptyMap(), context: Map<String, Any?> = emptyMap())

    fun identify(userId: String, traits: Map<String, Any?> = emptyMap(), context: Map<String, Any?> = emptyMap())

    fun group(groupId: String, traits: Map<String, Any?> = emptyMap(), context: Map<String, Any?> = emptyMap())

    fun screen(screenName: String, category: String = "", properties: Map<String, Any?> = emptyMap(), context: Map<String, Any?> = emptyMap())
}

/**
 * This file provides type-safe wrappers for tracking events with RudderStack based on your tracking plan.
 * It depends on no SDK, so it compiles in Kotlin Multiplatform common code and in pure JVM modules.
 *
 * ## Tracking Plan
 {{ if .TrackingPlanURL }}* - **Name**: [{{ .TrackingPlanName }}]({{ .TrackingPlanURL }}){{ else }}* - **Name**: {{ .TrackingPlanName }}{{ end }}
 * - **ID**: {{ .TrackingPlanID }}
 * - **Version**: {{ .TrackingPlanVersion }}
 *
 * ## Quick Start
 *
 * Implement [RudderTyperTransport] on top of your platform's SDK, then create the client:
 * ```kotlin
 * val rudderTyper = RudderTyper(transport)
 * ```
 *
 * To send events to another workspace, for example staging, pass that workspace's tracking plan
 * ID and version: `RudderTyper(transport, trackingPlanId = "...", trackingPlanVersion = 3)`.
 */
class RudderTyper(
    private val transport: RudderTyperTransport,
    trackingPlanId: String = "{{ escapeString .TrackingPlanID }}",
    trackingPlanVersion: Int = {{ .TrackingPlanVersion }},
) {
    private val context: Map<String, Any?> = mapOf(
        "ruddertyper" to mapOf(
        {{- range $key, $value := .EventContext }}
            "{{ escapeString $key }}" to {{ if eq $key "trackingPlanId" }}trackingPlanId{{ else if eq $key "trackingPlanVersion" }}trackingPlanVersion{{ else }}{{ $value }}{{ end }},
        {{- end }}
        ),
    )
{{ range .RudderAnalyticsMethods }}
    /**
     * {{ escapeComment .Comment }}
     *
     * Event:
{{- if .EventName }}
     *   Name: "{{ .EventName }}"
{{- end }}
{{- if .IdentitySection }}
     *   Identity Section: "{{ .IdentitySection }}"
{{- end }}
{{- if .MethodArguments }}
     *
{{- range .MethodArguments }}
     * @param {{ .Name }}{{- if .Comment }} {{ escapeComment .Comment }}{{- end }}
{{- end }}
{{- end }}
     * @param customContext Optional custom context to add to this event
     */
    fun {{ .Name }}({{- range $i, $arg := .MethodArguments -}}{{- if $i }}, {{ end -}}{{- .Name }}: {{ .Type }}{{- if .Nullable }}?{{ end }}{{- if .IsLiteralDefault }} = {{ formatLiteral .Default }}{{- else if .Default }} = {{ .Default }}{{- end }}{{- end }}{{- if .MethodArguments }}, {{ end }}customContext: Map<String, Any?> = emptyMap()) {
        transport.{{ .SDKCall.MethodName }}(
        {{- range $i, $arg := .SDKCall.Arguments }}
            {{ .Name }} ={{- if .ShouldSerialize }} {{ .Value }}.rudderSerialize().toTransportMap(){{- else if .IsLiteral }} {{ formatLiteral .Value }}{{- else }} {{ .Value }}{{- end }},
        {{- end }}
            context = context
        {{- if .AddDataToContext }} + mapOf("traits" to traits.rudderSerialize().toTransportMap())
        {{- end }} + customContext
        )
    }
{{ end -}}
}

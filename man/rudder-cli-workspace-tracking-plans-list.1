.nh
.TH "RUDDER-CLI-WORKSPACE-TRACKING-PLANS-LIST" "1" "Jan 1970" "rudder-cli" "Rudder CLI Manual"

.SH NAME
rudder-cli-workspace-tracking-plans-list - List tracking plans in the workspace


.SH SYNOPSIS
\fBrudder-cli workspace tracking-plans list [flags]\fP


.SH DESCRIPTION
List tracking plans in the authenticated workspace, as a table or JSON.


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for list

.PP
\fB--json\fP[=false]
	Output as JSON


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB-c\fP, \fB--config\fP="~/.rudder/config.json"
	config file (default is '~/.rudder/config.json')


.SH EXAMPLE
.EX
rudder-cli workspace tracking-plans list
rudder-cli workspace tracking-plans list --json

.EE


.SH SEE ALSO
\fBrudder-cli-workspace-tracking-plans(1)\fP

.nh
.TH "RUDDER-CLI" "1" "Jan 1970" "rudder-cli" "Rudder CLI Manual"

.SH NAME
rudder-cli-retl-sources-validate - Validate a RETL source SQL model


.SH SYNOPSIS
\fBrudder-cli retl-sources validate  [flags]\fP


.SH DESCRIPTION
Validate a RETL source SQL model by executing the query without returning data


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for validate

.PP
\fB-l\fP, \fB--location\fP="."
	Path to the project directory


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB-c\fP, \fB--config\fP="~/.rudder/config.json"
	config file (default is '~/.rudder/config.json')


.SH EXAMPLE
.EX
$ rudder-cli retl-sources validate my-model
$ rudder-cli retl-sources validate my-model --location ./project

.EE


.SH SEE ALSO
\fBrudder-cli-retl-sources(1)\fP

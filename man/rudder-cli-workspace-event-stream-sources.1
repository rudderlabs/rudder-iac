.TH "RUDDER-CLI" "1" "Jan 1970" "rudder-cli" "Rudder CLI Manual"

.SH NAME
rudder-cli-workspace-event-stream-sources - Manage event stream sources in the workspace


.SH SYNOPSIS
\fBrudder-cli workspace event-stream-sources [flags]\fP


.SH DESCRIPTION
Inspect event stream source resources in the authenticated workspace. Use the list subcommand for table or JSON output.


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for event-stream-sources


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB-c\fP, \fB--config\fP="~/.rudder/config.json"
	config file (default is '~/.rudder/config.json')


.SH EXAMPLE
.EX
  rudder-cli workspace event-stream-sources list --json
.EE


.SH SEE ALSO
\fBrudder-cli-workspace(1)\fP, \fBrudder-cli-workspace-event-stream-sources-list(1)\fP

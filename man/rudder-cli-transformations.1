.nh
.TH "RUDDER-CLI-TRANSFORMATIONS" "1" "Jan 1970" "rudder-cli" "Rudder CLI Manual"

.SH NAME
rudder-cli-transformations - Manage transformations


.SH SYNOPSIS
\fBrudder-cli transformations  [flags]\fP


.SH DESCRIPTION
Manage the lifecycle of transformations and libraries


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for transformations


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB-c\fP, \fB--config\fP="~/.rudder/config.json"
	config file (default is '~/.rudder/config.json')


.SH EXAMPLE
.EX
$ rudder-cli transformations test my-transformation-id
$ rudder-cli transformations test --all
$ rudder-cli transformations test --modified

.EE


.SH SEE ALSO
\fBrudder-cli(1)\fP, \fBrudder-cli-transformations-show-default-events(1)\fP, \fBrudder-cli-transformations-test(1)\fP

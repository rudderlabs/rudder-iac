{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.invalid/rudder-cli/v1/root.json",
  "title": "Rudder specification (DEX-1012 spike fixture)",
  "description": "Kind-discriminated root used only to test editor behavior.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "kind", "metadata", "spec"],
  "properties": {
    "version": {
      "const": "rudder/v1",
      "description": "Rudder specification format version."
    },
    "kind": {
      "type": "string",
      "enum": ["event-stream-source", "data-graph"],
      "description": "Selects the resource schema applied to spec."
    },
    "metadata": {
      "type": "object",
      "description": "File-level Rudder metadata.",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Human-readable name for this specification file."
        }
      }
    },
    "spec": {
      "type": "object",
      "description": "Kind-specific resource configuration."
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["kind"],
        "properties": {
          "kind": { "const": "event-stream-source" }
        }
      },
      "then": {
        "properties": {
          "spec": {
            "$ref": "#/$defs/event_stream_source_spec"
          }
        }
      }
    },
    {
      "if": {
        "required": ["kind"],
        "properties": {
          "kind": { "const": "data-graph" }
        }
      },
      "then": {
        "properties": {
          "spec": {
            "$ref": "#/$defs/data_graph_spec"
          }
        }
      }
    }
  ],
  "$defs": {
    "event_stream_source_spec": {
      "type": "object",
      "description": "Configuration for the event stream source.",
      "additionalProperties": false,
      "required": ["id", "name", "type", "enabled"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Stable local identifier used in Rudder resource references."
        },
        "name": {
          "type": "string",
          "description": "Human-readable source name."
        },
        "type": {
          "type": "string",
          "enum": ["android", "ios", "web"],
          "description": "Event stream SDK source type."
        },
        "enabled": {
          "type": "boolean",
          "description": "Whether this source accepts events."
        }
      }
    },
    "data_graph_spec": {
      "type": "object",
      "description": "Data graph and model configuration.",
      "additionalProperties": false,
      "required": ["id", "account_id", "models"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Stable local identifier for the data graph."
        },
        "account_id": {
          "type": "string",
          "description": "Warehouse account used to resolve model tables."
        },
        "models": {
          "type": "array",
          "description": "Entity and event models in this graph.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "display_name", "type", "table"],
            "properties": {
              "id": { "type": "string" },
              "display_name": { "type": "string" },
              "type": { "type": "string", "enum": ["entity", "event"] },
              "table": { "type": "string" },
              "primary_id": { "type": "string" },
              "timestamp": { "type": "string" }
            }
          }
        }
      }
    }
  }
}

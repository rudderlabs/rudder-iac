{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.invalid/rudder-cli/v1/event-stream-source.json",
  "title": "Rudder event stream source (DEX-1012 spike fixture)",
  "description": "Illustrative schema used only to test editor association and language features.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "kind", "metadata", "spec"],
  "properties": {
    "version": {
      "const": "rudder/v1",
      "description": "Rudder specification format version."
    },
    "kind": {
      "const": "event-stream-source",
      "description": "Declares an event stream source resource."
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "spec": {
      "type": "object",
      "description": "Configuration for the event stream source.",
      "additionalProperties": false,
      "required": ["id", "name", "type", "enabled"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Stable local identifier used in Rudder resource references."
        },
        "name": {
          "type": "string",
          "description": "Human-readable source name."
        },
        "type": {
          "type": "string",
          "enum": ["android", "ios", "web"],
          "description": "Event stream SDK source type."
        },
        "enabled": {
          "type": "boolean",
          "description": "Whether this source accepts events."
        }
      }
    }
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "description": "File-level Rudder metadata.",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Human-readable name for this specification file."
        }
      }
    }
  }
}

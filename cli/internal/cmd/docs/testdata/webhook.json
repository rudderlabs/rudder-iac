{
  "schemaVersion": 1,
  "cliVersion": "1.2.3",
  "type": "webhook",
  "displayName": "Webhook",
  "apiType": "WEBHOOK",
  "definitionVersion": 1,
  "verified": true,
  "source": {
    "type": "javascript",
    "token": "web"
  },
  "connectionModes": {
    "web": {
      "modes": [
        "cloud"
      ],
      "requiredKeys": {}
    }
  },
  "secretKeys": [
    "headers.to"
  ],
  "fields": [
    {
      "key": "webhook_url",
      "type": "string",
      "required": true,
      "pattern": "webhook_url",
      "acceptsTemplate": true
    },
    {
      "key": "webhook_method",
      "type": "string",
      "enum": [
        "POST",
        "PUT",
        "PATCH",
        "GET",
        "DELETE"
      ],
      "default": "POST"
    },
    {
      "key": "headers[].from",
      "type": "string",
      "pattern": "single_line_1000",
      "acceptsTemplate": true
    },
    {
      "key": "headers[].to",
      "type": "string",
      "pattern": "single_line_1000",
      "acceptsTemplate": true,
      "secret": true,
      "var": "STOREFRONT_WEBHOOK_HEADERS_<N>_TO",
      "slot": "'{{ .STOREFRONT_WEBHOOK_HEADERS_<N>_TO }}'"
    },
    {
      "key": "connection_mode",
      "type": "map<sourceToken,string>"
    },
    {
      "key": "consent_management",
      "type": "map<sourceToken,array<object>>"
    }
  ],
  "patterns": {
    "single_line_1000": {
      "regex": "^(.{0,1000})$",
      "message": "must be at most 1000 characters and must not contain line breaks"
    },
    "webhook_url": {
      "regex": "^(https?://)([a-zA-Z0-9-]{1,63}\\.)+[a-zA-Z]{2,}(:(6553[0-5]|655[0-2][0-9]|65[0-4][0-9]{2}|6[0-4][0-9]{3}|[1-5]\\d{4}|[1-9]\\d{1,3}))?(/.*)?$",
      "reject": "^https?://([a-zA-Z0-9-]*\\.ngrok\\.io|localhost|.*\\.localhost)",
      "message": "must be a public http(s) domain URL and must not use localhost or ngrok"
    }
  },
  "customValidators": [],
  "specTemplate": "version: rudder/v1\nkind: destination\nmetadata:\n  name: storefront-webhook\nspec:\n  id: storefront-webhook\n  display_name: storefront-webhook\n  type: webhook\n  definition_version: 1\n  enabled: true\n  config:\n    webhook_url: null\n    connection_mode:\n      web: cloud\n"
}

#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
bin

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# IDEs
.vscode

# macOS
.DS_Store

# Log files
*.log

# Added by goreleaser init:
dist/

# Generated documentation artifacts (not committed)
docs/generated/
man/*.1

# Cline memory-bank
memory-bank


**/linear-task-**.mdc

# Rudder typer platform specific
.gradle
.idea
typer/generator/platforms/kotlin/testdata/validator/build
typer/generator/platforms/kotlin/testdata/validator/gradle
